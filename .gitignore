# Local planning and private research artifacts.
# Keep these out of any future Agent-Blackbox repository history.
.gjc/
local-planning/
.agent-blackbox-local/
*.local.md
*.private.md
events.ndjson
trace.db
trace.db-*
captures/
screenshots/
raw-logs/
.playwright-mcp/
*.png
*.jpeg
*.jpg
node_modules/
dist/

# Compiled output must never sit beside a source file: Vitest and tsx resolve a
# `./x.js` import to the real file if one exists, so a stray build artifact silently
# tests yesterday's code. This bit v0.49.4, where 20 of them were committed by mistake.
packages/*/src/*.js
packages/*/src/*.d.ts
packages/*/src/*.js.map
packages/*/src/*.d.ts.map
apps/*/src/*.js
apps/*/src/*.d.ts
# …but this one is hand-written, not output (a trailing comment would be part of the pattern).
!apps/dashboard/src/vite-env.d.ts
*.tsbuildinfo
.turbo/
.vite/
coverage/

# Tracked documentation assets
!docs/screenshots/
!docs/screenshots/*.jpeg

.DS_Store
